// Reproducible Kubernetes profile for RNA-seq analysis workflow (Hisat2, RS1).
// VIVO run:      http://example.org/vivo-import/run-metadata/workflow/rna-seq-analysis-hisat2-rs1
// Workflow src:  https://github.com/Nine-s/nextflow_RS1_hisat2_new
// Pinned commit: 6b7688c7cab3c0bdb39e0e228ceab2bac31e2caa
// Read set RS1:  SRR1509507, SRR14197369, SRR14404397 (D. melanogaster, Ensembl BDGP6.32 r106)

docker.enabled = false

params {
    reads = '/workspace/data/reads/*_{1,2}.fastq.gz'

    ensembl_release = '106'
    assembly = 'BDGP6.32'
    reference_genome = '/workspace/data/reference/Drosophila_melanogaster.BDGP6.32.dna.toplevel.fa'
    reference_cdna = '/workspace/data/reference/Drosophila_melanogaster.BDGP6.32.cdna.all.fa'
    reference_annotation = '/workspace/data/reference/Drosophila_melanogaster.BDGP6.32.106.gtf'
    reference_annotation_ensembl = '/workspace/data/reference/Drosophila_melanogaster.BDGP6.32.106.gtf'

    // HISAT2 index strategy. exon_splice_site => splice-aware index built from
    // GTF exons + splice sites, aligning FASTP-trimmed reads (standard RNA-seq).
    mode = 'exon_splice_site'

    // The python-labelled helpers run `python ${params.baseDir}/bin/*.py`.
    baseDir = '/workspace/rnaseq-hisat2-rs1/source'
    outdir = '/workspace/results/HISAT2-RS1-RUN01'

    threads = 8
}

process {
    executor = 'k8s'
    errorStrategy = 'terminate'

    withName: CHECK_STRANDNESS {
        container = 'ninedem/check_strandedness@sha256:1a8e1b00f51f02ad4c7876975d735b9f4ee7c365f1d499eceb3a35fdea8dcdde'
        cpus = 4
        memory = '8 GB'
    }

    withLabel: fastp {
        container = 'biocontainers/fastp@sha256:36c3841644a023f360c1e33ac2497dc91755d4ace5e2b1162e16304b8f5179d0'
        cpus = 8
        memory = '8 GB'
    }

    // The committed HISAT2 helpers use Python 3 syntax but invoke `python`.
    // The strandness image ships Python 3.8 (+ procps for Nextflow metrics) as
    // `python3`; provide the alias the repository expects.
    withLabel: python {
        container = 'ninedem/check_strandedness@sha256:1a8e1b00f51f02ad4c7876975d735b9f4ee7c365f1d499eceb3a35fdea8dcdde'
        beforeScript = 'ln -sf /usr/bin/python3 /usr/local/bin/python'
        cpus = 1
        memory = '4 GB'
    }

    withLabel: hisat2 {
        container = 'quay.io/biocontainers/hisat2@sha256:21be9c91bf66404e677bc2c70e986e39ce9a40e7950d5034e3561bb992e82ec6'
        cpus = 8
        memory = '16 GB'
    }

    withName: HISAT2_INDEX_REFERENCE {
        maxForks = 1
    }

    withName: HISAT2_ALIGN {
        maxForks = 3
    }

    withLabel: samtools {
        container = 'quay.io/biocontainers/samtools@sha256:557b8fd747df1965feb4e81360a3dd24f0890d7a3b91a0c993a375e1dc08beca'
        cpus = 2
        memory = '12 GB'
        maxForks = 3
    }

    withLabel: cufflinks {
        container = 'pgcbioinfo/cufflinks@sha256:833b5af0c5790093821aa064f5bd87543d9589b90c4a0450927051594e4bb52d'
        cpus = 8
        memory = '32 GB'
        maxForks = 1
    }
}

executor.queueSize = 6
workDir = '/workspace/work-hisat2-rs1-run01'

k8s {
    namespace = System.getenv('RNASEQ_NAMESPACE') ?: 'yagmur'
    serviceAccount = System.getenv('RNASEQ_SA') ?: 'nextflow-sa'
    storageClaimName = System.getenv('RNASEQ_PVC') ?: 'rnaseq-pvc'
    storageMountPath = '/workspace'
    workDir = '/workspace/work-hisat2-rs1-run01'
    launchDir = '/workspace/rnaseq-hisat2-rs1/source'
    projectDir = '/workspace/rnaseq-hisat2-rs1/source'
    runAsUser = 0
    imagePullPolicy = 'IfNotPresent'
}
